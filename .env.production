# ─────────────────────────────────────────────────────────────
# Environment PRODUCTION — di-load pas `npm run build` & `next start` (di VPS).
# TIDAK ke-load pas `npm run dev` lokal.
#
# ⚠️ FILE INI IKUT GIT → HANYA untuk nilai PUBLIC (mis. Pixel ID).
#    JANGAN taruh secret/password/API key di sini (GitHub bakal nolak push).
#    Secret di-inject saat deploy ke .env.production.local (lihat di bawah).
# ─────────────────────────────────────────────────────────────

# Meta / Facebook Pixel — public, aman di-commit
NEXT_PUBLIC_FB_PIXEL_ID=383134319660606

# TikTok Pixel — kosongin dulu, isi kalau sudah ada
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─────────────────────────────────────────────────────────────
# Auto-buat akun member dari webhook orderonline.id
#
# 🔒 SECRET TIDAK DITARUH DI SINI. Saat deploy, GitHub Actions menulis
#    .env.production.local di VPS (gitignored) — sebagian dari GitHub Secrets:
#      OO_WEBHOOK_SECRET, PB_SERVICE_PASSWORD, SMTP_USER, SMTP_PASS
#    Nilai non-secret (host/port/from/dll) di-set di:
#      .github/workflows/deploy.yml
#
# Untuk tes di dev lokal: bikin file .env.local sendiri (gitignored),
# isi key yang sama. Daftar lengkap key ada di .env.example.
# ─────────────────────────────────────────────────────────────
