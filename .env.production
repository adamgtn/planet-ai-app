# ─────────────────────────────────────────────────────────────
# Environment PRODUCTION — di-load CUMA pas `npm run build` (di VPS),
# TIDAK pas `npm run dev` lokal. Jadi pixel cuma nyala di web live,
# nggak ngotorin data pixel pas development.
#
# Pixel ID = public (keliatan di browser), jadi aman di-commit.
# Ganti / matiin: edit baris di bawah → `npm run push` → auto-deploy.
# ─────────────────────────────────────────────────────────────

# Meta / Facebook Pixel
NEXT_PUBLIC_FB_PIXEL_ID=383134319660606

# TikTok Pixel — kosongin dulu, isi kalau sudah ada
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
