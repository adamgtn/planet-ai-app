# ─────────────────────────────────────────────────────────────
# Marketing Pixels (OPSIONAL)
#
# Isi kalau mau pasang iklan Meta (Facebook/Instagram) / TikTok.
# Kosongin = pixel TIDAK dipasang (aman, nggak error).
#
# Cara ganti: edit value di bawah, lalu re-deploy / rebuild app.
# Nggak perlu ngedit kode sama sekali.
# ─────────────────────────────────────────────────────────────

# Meta / Facebook Pixel ID — angka dari Events Manager
# (https://business.facebook.com/events_manager)
NEXT_PUBLIC_FB_PIXEL_ID=

# TikTok Pixel ID — dari TikTok Ads Manager → Assets → Events → Web Events
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ─────────────────────────────────────────────────────────────
# Auto-buat akun member dari webhook orderonline.id (OPSIONAL)
#
# Kalau diisi: setiap order LUNAS di orderonline.id otomatis bikin
# akun member di PocketBase + kirim email kredensial.
# Kosongin = fitur mati (webhook tetap ada tapi butuh secret untuk jalan).
#
# Endpoint webhook (set di orderonline.id, trigger HANYA saat Lunas):
#   https://planetsoft.id/api/orderonline/webhook?secret=<OO_WEBHOOK_SECRET>
# ─────────────────────────────────────────────────────────────

# Secret bebas (huruf+angka panjang) — harus SAMA dengan yang dipasang di webhook orderonline.id
OO_WEBHOOK_SECRET=

# Akun service PocketBase ber-role "admin" (buat via: npm run pb:create-service-admin)
# JANGAN pakai kredensial superuser di sini.
PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=

# URL PocketBase (default https://db.planet-ai.tech kalau kosong)
NEXT_PUBLIC_PB_URL=

# ─── SMTP untuk kirim email kredensial ke member ───
# Contoh Gmail: host=smtp.gmail.com port=587, user=emailmu@gmail.com,
# pass=APP PASSWORD (bukan password biasa — bikin di Google Account → Security → App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Alamat pengirim yang tampil. Kosong = pakai SMTP_USER. Cth: "PlanetPrompt <no-reply@planetsoft.id>"
SMTP_FROM=
# Opsional: "true" untuk port 465 (SSL). Default auto dari port.
SMTP_SECURE=

# Halaman login member (default https://planetsoft.id/login)
APP_LOGIN_URL=
